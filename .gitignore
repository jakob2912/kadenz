# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Zielverzeichnis von `NEXT_DIST_DIR=.next-build npm run build` (siehe
# .env.example). Ohne diese Zeile landete ein kompletter Produktionsbau im
# Repo, weil oben nur /.next/ ausgeschlossen ist.
/.next-build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Auch die Vorlage bleibt draußen: alles, was mit .env anfängt, gehört nicht
# ins Repo. .env.example liegt weiter lokal im Projektordner und dient dort
# als Nachschlagewerk, welche Variablen gesetzt werden müssen.

# Von `prisma generate` erzeugt (läuft als postinstall, auch auf Vercel).
# Rund 10 MB samt WASM-Engine, die sich bei jeder Schemaänderung ändern —
# im Repo wäre das nur Ballast und ständiger Diff-Lärm.
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CodeGraph-Index: lokal erzeugt, nicht teilen
/.codegraph/
