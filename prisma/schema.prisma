// Kadenz — Datenmodell
//
// Bewusst schlank: Gewicht, Schlaf, Ruhepuls und HRV bleiben in Google Health,
// das ist dort die Quelle der Wahrheit und wird nicht dupliziert. Hier liegt
// nur, was Google Health nicht kennt — die Trainingslogs und die Ernährung.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: die Verbindungs-URLs stehen nicht mehr hier, sondern in
// prisma.config.ts (Migrationen) bzw. im Adapter in src/lib/db.ts (Laufzeit).
datasource db {
  provider = "postgresql"
}

/// Schlüssel-Wert-Ablage für Dinge, die App und MCP-Server gemeinsam brauchen.
///
/// Vor allem der Google-Refresh-Token: der liegt sonst nur in einem
/// httpOnly-Cookie, an das ein separater Prozess nicht herankommt. In der
/// Datenbank hat ihn genau eine Stelle, und der spätere Nacht-Job kann ihn
/// ebenfalls nutzen, ohne dass ein Browser offen sein muss.
model Einstellung {
  schluessel   String   @id
  wert         String
  aktualisiert DateTime @updatedAt
}

model Workout {
  id         String    @id @default(cuid())
  /// Trainingstag in Ortszeit — nicht der Zeitstempel, sonst rutscht ein
  /// spätes Training über Mitternacht auf den Folgetag.
  date       DateTime  @db.Date
  /// "push" (anterior) oder "pull" (posterior) — Jakobs eigene Einteilung
  kind       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  note       String?
  sets       SetLog[]

  /// Eine Einheit pro Tag und Art — von der Datenbank erzwungen, nicht nur von
  /// der Anwendung angenommen.
  ///
  /// workoutHeute() prüft erst mit findFirst und legt dann mit create an. Zwei
  /// gleichzeitige Aufrufe (zweiter Tab, PWA neben Safari, MCP-Server parallel
  /// zur App) lesen beide "nichts da" und legen beide an. Die Sätze eines Tages
  /// verteilen sich dann auf zwei Zeilen, und letzteSaetze() liest nur eine
  /// davon — beim nächsten Training fehlt die Hälfte.
  @@unique([date, kind])
  @@index([date])
}

model SetLog {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  /// Übungsname als Text statt Fremdschlüssel: Übungen wechseln (Gerät belegt,
  /// Schulter zwickt), und ein starrer Katalog würde das nur behindern.
  exercise String
  setIndex Int
  kg       Float
  reps     Int
  loggedAt DateTime @default(now())

  /// War der Satz technisch sauber?
  ///
  /// NULL heißt "nicht beurteilt" und ist der Normalfall — bei sechzehn Sätzen
  /// je Einheit soll niemand sechzehnmal etwas bestätigen müssen. Ein
  /// ausdrückliches false heißt: die Wiederholung stand, aber die Form nicht.
  /// Bei Jakob ist das die Hüfte, die sich von der Bank hebt.
  ///
  /// Der Grund für die Spalte ist ausschließlich die Messung. Sein
  /// All-Time-Bestwert von 100 kg war genau so einer, und ein Programm, das
  /// aus einem solchen Satz den nächsten Trainingsmax fortschreibt, rechnet
  /// mit Kilogramm, die technisch nie gestanden haben. Deshalb übergehen
  /// amrapSatzVon(), e1rmReihe() und besterSatz() Zeilen mit false — nicht
  /// aber die Historie: der Satz hat stattgefunden und bleibt sichtbar.
  ///
  /// Dreiwertig statt Boolean mit Default true: "nicht beurteilt" und
  /// "geprüft und sauber" sind verschiedene Aussagen, und nur die zweite
  /// rechtfertigt später ein Urteil über die Technik.
  sauber Boolean?

  /// Deckt die häufigste Abfrage ab: "was habe ich bei X zuletzt gemacht?"
  @@unique([workoutId, exercise, setIndex])
  @@index([exercise, loggedAt])
}

// ─────────────────────────────────────────────────────────────
// Ernährung
// ─────────────────────────────────────────────────────────────

/// Eine Mahlzeit aus Jakobs Fitnessbell-Plan.
///
/// Warum in der Datenbank und nicht als Konstante im Code wie SESSIONS in
/// plan.ts: der Plan ändert sich, wenn Fitnessbell ihn ändert — und dann soll
/// nicht deployt werden müssen. Das Trainingsprogramm steht im Code, weil die
/// Progression daran rechnet; am Essensplan rechnet nichts, er wird gelesen.
model Mahlzeit {
  id String @id @default(cuid())

  /// Reihenfolge im Tag, 1-basiert. Nicht die Uhrzeit: das Essensfenster
  /// verschiebt sich mit dem Trainingszeitpunkt, die Reihenfolge nie.
  position Int    @unique
  /// "Meal 1" … "Intra" — die Bezeichnung aus dem Plan, unverändert.
  name     String
  /// "Frühstück", "Shake", "Pre", "Training", "Post", "Abend"
  fenster  String

  zutaten Zutat[]
}

model Zutat {
  id         String   @id @default(cuid())
  mahlzeitId String
  mahlzeit   Mahlzeit @relation(fields: [mahlzeitId], references: [id], onDelete: Cascade)

  position Int
  name     String
  menge    Float
  /// "g" oder "Stk" — im Plan gibt es nur diese beiden.
  einheit  String

  /// Ausdrücklich erlaubte Ersetzung, etwa "oder 250 g Beeren" bei der Banane
  /// in Meal 3. Als eigenes Feld statt im Namen, damit die Zeile lesbar
  /// bleibt und die Alternative nicht wie ein Teil der Zutat aussieht.
  alternative String?

  /// Trägt diese Zutat eine Änderung des Kalorienziels mit?
  ///
  /// Wahr bei den Kohlenhydratquellen — Reis, Haferflocken, Reispudding,
  /// Maltodextrin. Der Coach bewegt ausschließlich die Kohlenhydrate (siehe
  /// kalorienAnpassung() in coach.ts), also sind sie es auch, die im Teller
  /// weniger werden. Eiweiß- und Fettquellen bleiben, sonst nähme eine
  /// Kürzung genau das weg, was ausdrücklich stehen bleiben soll.
  ///
  /// Als Feld statt als Namensliste im Code: welche Zutat nachgibt, ist eine
  /// Ernährungsentscheidung und ändert sich mit dem Plan — derselbe Grund,
  /// aus dem saetzeBankTag in der Datenbank steht und nicht im Quelltext.
  anpassbar Boolean @default(false)

  @@unique([mahlzeitId, position])
}

/// Ein Kalorien- und Makroziel ab einem Stichtag — die Historie.
///
/// Jede Änderung legt eine neue Zeile an, nichts wird überschrieben. Nur so
/// ist später beantwortbar, warum das Ziel bei 3800 statt 3600 steht und wann
/// das entschieden wurde. Das aktuelle Ziel ist die jüngste Zeile.
model Ernaehrungsziel {
  id String @id @default(cuid())

  /// Erster Tag, an dem dieses Ziel gilt — Kalendertag in Wiener Zeit.
  /// Gleichzeitig der Beginn der neuen Messreihe: der Trend vor einer
  /// Anpassung sagt nichts über die Zeit danach.
  gueltigAb DateTime @db.Date

  kcal           Int
  kohlenhydrateG Int
  eiweissG       Int
  fettG          Int

  /// Von wem das Ziel stammt:
  /// "plan"   — aus dem Fitnessbell-Plan übernommen, nicht berechnet
  /// "coach"  — von Kadenz vorgeschlagen UND von Jakob bestätigt; anders
  ///            kommt ein Coach-Ziel nicht in diese Tabelle
  /// "jakob"  — von Hand gesetzt
  quelle String

  /// Warum. Bei "coach" die Begründung des Vorschlags im Wortlaut, damit sie
  /// auch dann noch lesbar ist, wenn die Gewichtsreihe längst weitergelaufen ist.
  begruendung String

  gesetztAm DateTime @default(now())

  /// Der Vorschlag, aus dem dieses Ziel hervorging. Eins zu eins: ein
  /// angenommener Vorschlag erzeugt genau ein Ziel.
  vorschlagId String?            @unique
  vorschlag   Kalorienvorschlag? @relation(fields: [vorschlagId], references: [id], onDelete: SetNull)

  @@index([gesetztAm])
}

/// Ein Vorschlag des Coaches, das Kalorienziel zu ändern.
///
/// Getrennt vom Ziel, weil ein Vorschlag kein Ziel ist: er wartet auf Jakobs
/// Ja. Erst das Ja legt ein Ernaehrungsziel an. Ein Nein bleibt trotzdem
/// stehen — sonst schlüge der Coach zwei Tage später dasselbe wieder vor.
model Kalorienvorschlag {
  id         String   @id @default(cuid())
  erstelltAm DateTime @default(now())

  /// Alter und neuer Zustand vollständig, nicht nur das Delta: der Vorschlag
  /// muss auch dann noch lesbar sein, wenn das Ziel inzwischen dreimal
  /// weitergewandert ist.
  kcalAlt           Int
  kcalNeu           Int
  kohlenhydrateAltG Int
  kohlenhydrateNeuG Int
  /// Bleiben bei einer Anpassung unverändert — die zusätzlichen Kalorien
  /// gehen in die Kohlenhydrate. Trotzdem mitgeschrieben, damit der Vorschlag
  /// ein vollständiges Ziel beschreibt und nicht nur zwei Zahlen davon.
  eiweissG          Int
  fettG             Int

  /// Die gemessene Rate in kg/Woche, auf der der Vorschlag beruht, und der
  /// Zielwert, gegen den verglichen wurde. Ohne diese beiden ist im Nachhinein
  /// nicht mehr nachvollziehbar, ob der Vorschlag richtig war.
  gemesseneRate Float
  zielRate      Float

  begruendung String

  /// "offen" | "angenommen" | "abgelehnt" | "ersetzt"
  status        String    @default("offen")
  entschiedenAm DateTime?

  /// Erzwingt: höchstens ein offener Vorschlag.
  ///
  /// Steht auf dem festen Wert "offen", solange der Vorschlag offen ist, und
  /// auf NULL, sobald entschieden wurde — Postgres lässt beliebig viele NULL
  /// in einem eindeutigen Index zu, aber nur ein einziges "offen".
  ///
  /// Nötig, weil der Vorschlag beim Rendern der Ernährungsseite entsteht:
  /// zwei gleichzeitige Aufrufe (zweiter Tab, PWA neben Safari, MCP-Server
  /// parallel) läsen sonst beide "noch keiner da" und legten beide einen an —
  /// derselbe Fehler, den @@unique([date, kind]) bei Workout verhindert.
  offenSchluessel String? @unique

  ziel Ernaehrungsziel?

  @@index([erstelltAm])
}

// ─────────────────────────────────────────────────────────────
// Trainingsprogramm
// ─────────────────────────────────────────────────────────────

/// Eine Übung im Split.
///
/// Stand bis hierher als Konstante SESSIONS in src/lib/plan.ts — die Datei
/// hat es selbst angekündigt: "sobald die Datenbank steht, kommen sie von
/// dort". Der Grund, es jetzt zu tun: eine Übung tauschen (Gerät belegt,
/// Schulter zwickt) brauchte bisher ein Deployment. Aus Claude Desktop heraus
/// soll das ein Werkzeugaufruf sein.
///
/// Ausdrücklich KEIN Fremdschlüssel von SetLog hierher. Der Kommentar dort
/// gilt weiter: geloggt wird auch, was nicht im Katalog steht.
model Uebung {
  id String @id @default(cuid())

  /// "push" (anterior) oder "pull" (posterior)
  einheit  String
  /// Reihenfolge in der Einheit, 1-basiert.
  position Int
  /// Der Name, unter dem auch geloggt wird — die Verbindung zu SetLog.exercise.
  name     String
  notiz    String?

  /// Nicht-null heißt: die Sätze dieser Übung gibt ein Programm vor, nicht
  /// progression(). Bisher nur "531" für das Bankdrücken.
  programm String?

  /// In welcher Ausprägung der Einheit diese Übung vorkommt.
  ///
  /// NULL heißt "in jeder" — das gilt für die große Mehrheit und ist der
  /// Grund, warum die Spalte nullable ist statt einer Pflichtangabe: der
  /// bestehende Katalog bleibt unverändert richtig.
  ///
  /// Der Anlass: Push sieht nicht an jedem Push-Tag gleich aus. Am TM-Tag
  /// steht das schwere 5/3/1-Bankdrücken, an der Einheit dazwischen eine
  /// submaximale Variante. Beide sind Push, beide gehören in den Katalog,
  /// aber nie am selben Tag. Ohne diese Spalte ließe sich die zweite nur
  /// hinzufügen, indem sie auch am schweren Tag erschiene.
  ///
  /// Die Werte kommen aus varianteFuer() in kraft.ts und lauten:
  ///   "schwer" — Push am TM-Tag: Langhantel-Bankdrücken nach 5/3/1
  ///   "leicht" — Push an der Einheit dazwischen: Paused Bench Press
  ///   "presse" — Pull nach einem leichten Push-Tag: Spoto Press
  /// Ein Tag ohne passende Variante ("ohne" in der Deload-Woche, "rein" beim
  /// gewöhnlichen Pull) trägt schlicht keine variantengebundene Übung.
  ///
  /// Ausdrücklich KEIN Wochentag, obwohl der Wunsch so formuliert war.
  /// Jakobs Rotation läuft alle drei Tage (siehe rotationFor() in plan.ts) —
  /// ein Montag ist mal Push, mal Pull, mal Pause. Ein Wochentagsfeld hätte
  /// die Übung in zwei von vier Wochen am falschen Tag gezeigt oder gar
  /// nicht. Was tatsächlich abwechselt, ist die Position in der 5/3/1-Welle,
  /// und daran hängt die Variante.
  variante String?

  /// Wie viele Sätze diese Übung vorsieht.
  ///
  /// Stand bis hierher nirgends. heutigeSaetze() zählte stattdessen die Sätze
  /// der zuletzt geloggten Einheit, ersatzweise die Länge von startWdh — und
  /// eine über den MCP-Server ohne startWdh angelegte Übung bekam damit gar
  /// keine. Genau das ist beim Adductor passiert: er stand im Plan, hatte aber
  /// null Sätze und 0 kg als Zielgewicht.
  ///
  /// Der zweite Grund ist subtiler: hing die Anzahl an der letzten Einheit,
  /// schrumpfte der Plan still mit. Wer von zwei geplanten Sätzen nur einen
  /// abhakte, bekam beim nächsten Training nur noch einen vorgeschlagen.
  ///
  /// Default 2, weil das Jakobs Regel ist. Ausnahmen stehen als Wert in der
  /// Zeile, nicht als Sonderfall im Code.
  saetze Int @default(2)

  /// Abweichende Satzanzahl an TM-Tagen. Null heißt: keine Reduktion.
  ///
  /// An einem TM-Tag kommen drei schwere Sätze Langhantel-Bankdrücken dazu.
  /// Die Incline Chest Press trifft dieselbe Muskulatur; ihr voller Umfang
  /// obendrauf ist Volumen, das die Erholung kostet, ohne mehr zu bringen.
  ///
  /// Als Feld statt als Übungsname im Code: welche Übung nachgibt, ist eine
  /// Trainingsentscheidung und ändert sich, sobald der Split sich ändert. Ein
  /// hart verdrahtetes "Incline Chest Press" hätte für jede solche Änderung
  /// ein Deployment gebraucht — genau der Grund, aus dem der Katalog
  /// überhaupt in der Datenbank steht.
  ///
  /// Greift ausschließlich, wenn bankstandFuer() den Tag als TM-Tag ausweist —
  /// nicht an der submaximalen Zusatz-Einheit dazwischen, die kostet den
  /// übrigen Übungen nichts. An Pull-Tagen gibt es keinen Bankstand, dort kann
  /// die Reduktion strukturell nicht zuschlagen.
  saetzeBankTag Int?

  /// Referenzwerte aus dem Kraftwerte-Log, solange die Übung noch nie
  /// geloggt wurde. Sobald ein Satz in SetLog liegt, zählt ausschließlich der.
  ///
  /// Die Wiederholungen als Liste statt als Zahl plus Satzanzahl: Jakobs
  /// zweiter Satz ist meist einen weniger, aber nicht immer — bei Crunch und
  /// Trizeps-Pushdown stehen zweimal 5. Eine abgeleitete Regel wäre bei zwei
  /// von sechzehn Übungen falsch gewesen.
  startKg  Float?
  startWdh Int[]

  /// Kein aktiv-Kennzeichen: eine getauschte Übung wird gelöscht.
  ///
  /// Ihre Sätze überleben das ohnehin — SetLog.exercise ist Freitext ohne
  /// Fremdschlüssel, der Kraftverlauf findet sie weiter unter ihrem Namen.
  /// Eine stillgelegte Zeile würde dagegen ihren Platz in
  /// @@unique([einheit, position]) weiter belegen und müsste beim Umsortieren
  /// mitgeschoben werden, ohne dass sie irgendwo angezeigt wird.

  /// Beide erzwungen: keine zwei Übungen auf demselben Platz, kein Name
  /// zweimal in derselben Einheit — sonst wäre nicht mehr entscheidbar,
  /// welche Zeile zu einem SetLog gehört.
  @@unique([einheit, position])
  @@unique([einheit, name])
}

/// Der Trainingsmax fürs Bankdrücken, je Zyklus eine Zeile.
///
/// Anhängend wie Ernaehrungsziel: nichts wird überschrieben. Nur so ist
/// später beantwortbar, warum der Trainingsmax steht, wo er steht — ob er
/// gestiegen ist oder nach einem verfehlten AMRAP-Satz zurückgesetzt wurde.
model BankTrainingsmax {
  id String @id @default(cuid())

  /// Fortlaufend ab 1, aus dem Kalender abgeleitet (siehe bankPosition()).
  ///
  /// Eindeutig, und das ist der Zweck: der nächste Trainingsmax entsteht
  /// beiläufig beim Aufrufen des Plans. Zwei gleichzeitige Aufrufe — zweiter
  /// Tab, PWA neben Safari, MCP-Server parallel — läsen sonst beide "für
  /// diesen Zyklus noch nichts da" und legten beide eine Zeile an. Derselbe
  /// Griff wie offenSchluessel bei Kalorienvorschlag.
  zyklus Int @unique

  /// Erster Tag, an dem dieser Trainingsmax gilt — Kalendertag in Wiener Zeit.
  gueltigAb DateTime @db.Date

  tmKg Float

  /// "start"  — von Jakob einmalig eingetragen, es gab keine Historie
  /// "zyklus" — von Kadenz aus dem AMRAP-Satz fortgeschrieben
  /// "jakob"  — von Hand korrigiert
  quelle String

  /// Warum. Bei "zyklus" der Wortlaut aus naechsterTm().
  begruendung String

  gesetztAm DateTime @default(now())

  @@index([gesetztAm])
}
